{
    "name": "horde/composer",
    "description": "Handle composer.json files and composer directory structures without composer dependency",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "contributor"
        }
    ],
    "time": "2025-05-13",
    "repositories": [],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Horde\\Composer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Composer\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    }
}